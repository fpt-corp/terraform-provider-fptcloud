# Copy to .env (git-ignored), fill in, then run `source .env` (from any folder).
(return 0 2>/dev/null) || { echo "Run: source ${BASH_SOURCE[0]:-$0}  (running it does not change your shell)"; exit 1; }

# Path of this file's folder, whatever folder you source it from (bash or zsh).
export TF_CLI_CONFIG_FILE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/.terraformrc"

export FPTCLOUD_TOKEN=your_token
export FPTCLOUD_TENANT_NAME=your_tenant_name
export FPTCLOUD_REGION=VN/HAN
# export FPTCLOUD_API_URL=https://console-api.fptcloud.com/api
