# Makes Terraform load the provider built into .bin/ instead of downloading
# the published one. Terraform reads this file only when TF_CLI_CONFIG_FILE
# points at it (see .env.example). The path is relative to the directory
# Terraform runs in, so run Terraform from this folder.
provider_installation {
  dev_overrides {
    "registry.terraform.io/fpt-corp/fptcloud" = ".bin"
  }
  direct {}
}
